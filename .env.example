# Compose user and group IDs
PUID=1000
PGID=1000
VIDEO_GID=44

# Host and container paths used for recordings
CAMERA_STORAGE_PATH=./storage/recordings
CAMERA_STORAGE_CONTAINER=/recordings

# Existing reverse-proxy deployment settings
PROXY_NETWORK=proxy
APACHE_CONTAINER=apache
MOONFIRE_NETWORK=proxy
APACHE_HOST_CONFIG=/path/to/apache/default-ssl.conf
APACHE_AUTH_FILE=/path/to/persistent/cctv.htpasswd
APACHE_SSL_CONFIG=/etc/apache2/sites-enabled/default-ssl.conf
CCTV_DOMAIN=nvr.example.com
CCTV_URL=https://nvr.example.com
NVR_DIRECT_URL=http://127.0.0.1:8081

# Certificate host paths (adjust to the server)
WEBROOT=/var/www/html
LETSENCRYPT_DIR=/etc/letsencrypt
LETSENCRYPT_WORK_DIR=/var/lib/letsencrypt
